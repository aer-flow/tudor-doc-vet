---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Highlight from "../components/Highlight.astro";
import PawField from "../components/PawField.astro";
import { SITE_URL, NAP, WHATSAPP_URL } from "../data/site";

const title = "Veterinar pentru animale de fermă și gospodărie | Tudor Doc Vet Piatra Neamț";
const description =
  "Servicii veterinare pentru animale de fermă și gospodărie în zona Piatra Neamț: consultații, vaccinări, tratamente și deparazitare, la tine în curte. Sună: 0740 318 815.";

const farmServices = [
  { icon: "stethoscope" as const, title: "Consultații în teren", text: "Venim în gospodărie sau la fermă și examinăm animalele la fața locului, fără să le mai transporți." },
  { icon: "syringe" as const, title: "Vaccinări și profilaxie", text: "Vaccinări și program de prevenție pentru animalele din curte, potrivit cu ce crești." },
  { icon: "pill" as const, title: "Tratamente și deparazitare", text: "Tratăm afecțiunile curente și facem deparazitarea, cu indicații clare pentru ce urmează." },
];
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Servicii veterinare pentru animale de fermă",
  serviceType: "Veterinar animale de fermă",
  provider: { "@id": `${SITE_URL}/#cabinet` },
  areaServed: { "@type": "City", name: "Piatra Neamț" },
  description,
};
---
<Base title={title} description={description} schema={schema}>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-cream">
    <div class="container-page grid items-center gap-12 py-14 md:py-18 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="max-w-xl">
        <Eyebrow>Companie și fermă</Eyebrow>
        <h1 class="text-h1 font-extrabold text-ink">Grijă și pentru animalele <Highlight>din curte</Highlight>.</h1>
        <p class="measure mt-5 text-lead text-slate">
          Nu ne oprim la câini și pisici. Îngrijim și animalele din gospodărie și fermă, cu aceeași atenție. Venim la tine, în zona Piatra Neamț.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={`tel:${NAP.phoneE164}`} variant="primary" icon="phone" dataEvent="click_tel">Sună-ne</Button>
          <Button href={WHATSAPP_URL} variant="outline" icon="whatsapp" external dataEvent="click_whatsapp">WhatsApp</Button>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-[var(--radius-media)] bg-indigo-deep p-10">
        <PawField class="pointer-events-none absolute inset-0" opacity={0.09} />
        <div class="relative flex flex-col items-center justify-center py-6 text-center">
          <span class="inline-flex h-20 w-20 items-center justify-center rounded-3xl bg-sun text-ink"><Icon name="barn" size={40} /></span>
          <p class="mt-6 font-display text-[1.6rem] font-bold text-cream">În gospodărie și la fermă</p>
          <p class="mt-2 max-w-xs text-[0.96rem] text-cream/75">Venim în teren, în zona Piatra Neamț</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicii fermă -->
  <Section tone="ivory">
    <div class="max-w-2xl">
      <Eyebrow>Ce facem</Eyebrow>
      <h2 class="text-h2 font-bold text-ink">Aceeași grijă, în curtea ta.</h2>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {farmServices.map((f) => (
        <div class="flex h-full flex-col rounded-[var(--radius-card)] border border-line bg-cream p-7">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-indigo/8 text-indigo"><Icon name={f.icon} size={24} /></span>
          <h3 class="mt-5 font-display text-[1.2rem] font-bold text-ink">{f.title}</h3>
          <p class="mt-2.5 text-[0.98rem] leading-relaxed text-slate">{f.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- Bandă informativă -->
  <Section tone="cream">
    <div class="rounded-[var(--radius-media)] border border-line bg-sand p-8 sm:p-10">
      <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h2 class="text-h3 font-bold text-ink">Nu ești sigur dacă venim pentru animalul tău?</h2>
          <p class="measure mt-3 text-[1rem] text-slate">Sună-ne cu ce ai în gospodărie și unde stai. Îți spunem clar dacă ajungem și ce putem face în teren.</p>
        </div>
        <Button href={`tel:${NAP.phoneE164}`} variant="primary" icon="phone" dataEvent="click_tel">{NAP.phoneDisplay}</Button>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section tone="deep" class="relative overflow-hidden">
    <PawField class="pointer-events-none absolute inset-0" opacity={0.07} />
    <div class="relative mx-auto max-w-2xl text-center">
      <h2 class="text-h2 font-bold text-cream">Chemi veterinarul la curte?</h2>
      <p class="mx-auto mt-4 max-w-lg text-lead text-cream/75">Spune-ne ce animale ai și unde ești, iar noi venim pregătiți.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button href={`tel:${NAP.phoneE164}`} variant="primary" icon="phone" dataEvent="click_tel">Sună: {NAP.phoneDisplay}</Button>
        <Button href="/servicii/" variant="light" icon="arrow-right">Vezi toate serviciile</Button>
      </div>
    </div>
  </Section>
</Base>
