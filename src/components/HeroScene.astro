---
/**
 * Scena-semnătură: câine + pisică în line-art care se desenează singure
 * (SVG stroke-draw), pe panoul indigo. Linii profesionale (Tabler, MIT),
 * animate cu restrângere. Câinele în crem, pisica în marigold, labe accent.
 */
interface Props { class?: string }
const { class: className = "" } = Astro.props;

const dog = [
  "M11 5h2",
  "M19 12c-.667 5.333 -2.333 8 -5 8h-4c-2.667 0 -4.333 -2.667 -5 -8",
  "M11 16c0 .667 .333 1 1 1s1 -.333 1 -1h-2",
  "M12 18v2",
  "M5 4l6 .97l-6.238 6.688a1.021 1.021 0 0 1 -1.41 .111a.953 .953 0 0 1 -.327 -.954l1.975 -6.815",
  "M19 4l-6 .97l6.238 6.688c.358 .408 .989 .458 1.41 .111a.953 .953 0 0 0 .327 -.954l-1.975 -6.815",
];
const dogDots = ["M10 11v.01", "M14 11v.01"];

const cat = [
  "M20 3v10a8 8 0 1 1 -16 0v-10l3.432 3.432a7.963 7.963 0 0 1 4.568 -1.432c1.769 0 3.403 .574 4.728 1.546l3.272 -3.546",
  "M2 16h5l-4 4",
  "M22 16h-5l4 4",
  "M11 16a1 1 0 1 0 2 0a1 1 0 1 0 -2 0",
];
const catDots = ["M9 11v.01", "M15 11v.01"];

const paw =
  '<ellipse cx="6.4" cy="11" rx="1.9" ry="2.3"/><ellipse cx="9.7" cy="6.6" rx="1.9" ry="2.4"/><ellipse cx="14.3" cy="6.6" rx="1.9" ry="2.4"/><ellipse cx="17.6" cy="11" rx="1.9" ry="2.3"/><path d="M12 12.4c-2.7 0-4.8 1.9-4.8 4.2 0 1.7 1.4 2.7 3.1 2.7.9 0 1.2-.3 1.7-.3s.8.3 1.7.3c1.7 0 3.1-1 3.1-2.7 0-2.3-2.1-4.2-4.8-4.2Z"/>';
const paws = [
  { x: 40, y: 38, r: -12, i: 0, o: 0.9, s: 1.1 },
  { x: 322, y: 44, r: 14, i: 1, o: 0.85, s: 0.95 },
  { x: 300, y: 205, r: -8, i: 2, o: 0.7, s: 0.8 },
];
---
<svg
  class:list={["h-auto w-full", className]}
  viewBox="0 0 360 240"
  fill="none"
  aria-hidden="true"
>
  <!-- Câine (crem), se trasează primul -->
  <g
    transform="translate(28 58) scale(6)"
    stroke="var(--color-cream)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  >
    {dog.map((d) => (
      <path class="draw-path" style="--draw-i:0" pathLength="1" d={d} vector-effect="non-scaling-stroke" />
    ))}
    {dogDots.map((d) => (
      <path class="paw-stamp" style="--paw-i:0;--paw-o:1" d={d} vector-effect="non-scaling-stroke" />
    ))}
  </g>

  <!-- Pisică (marigold), se trasează a doua și se întrepătrunde -->
  <g
    transform="translate(190 58) scale(6)"
    stroke="var(--color-sun)"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"
  >
    {cat.map((d) => (
      <path class="draw-path" style="--draw-i:1" pathLength="1" d={d} vector-effect="non-scaling-stroke" />
    ))}
    {catDots.map((d) => (
      <path class="paw-stamp" style="--paw-i:1;--paw-o:1" d={d} vector-effect="non-scaling-stroke" />
    ))}
  </g>

  <!-- Labe accent care apar după -->
  <g fill="var(--color-sun-deep)">
    {paws.map((p) => (
      <g
        class="paw-stamp"
        style={`--paw-i:${p.i + 2};--paw-o:${p.o}`}
        transform={`translate(${p.x} ${p.y}) rotate(${p.r}) scale(${p.s}) translate(-12 -12)`}
        set:html={paw}
      />
    ))}
  </g>
</svg>
