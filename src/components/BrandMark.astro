---
/** Marca de brand: labă galbenă pe scut indigo (identică cu favicon-ul). */
interface Props { size?: number; class?: string }
const { size = 40, class: className = "" } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 100"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <rect width="100" height="100" rx="26" fill="var(--color-indigo)"></rect>
  <g fill="var(--color-sun)" transform="translate(50 54) scale(3.05) translate(-12 -12)">
    <ellipse cx="6.4" cy="11" rx="1.9" ry="2.3"></ellipse>
    <ellipse cx="9.7" cy="6.6" rx="1.9" ry="2.4"></ellipse>
    <ellipse cx="14.3" cy="6.6" rx="1.9" ry="2.4"></ellipse>
    <ellipse cx="17.6" cy="11" rx="1.9" ry="2.3"></ellipse>
    <path d="M12 12.4c-2.7 0-4.8 1.9-4.8 4.2 0 1.7 1.4 2.7 3.1 2.7.9 0 1.2-.3 1.7-.3s.8.3 1.7.3c1.7 0 3.1-1 3.1-2.7 0-2.3-2.1-4.2-4.8-4.2Z"></path>
  </g>
</svg>
