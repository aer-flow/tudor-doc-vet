---
/** Câmp decorativ cu urme de labă, subtil, ca textură de brand pe scene închise. */
interface Props { class?: string; color?: string; opacity?: number }
const { class: className = "", color = "var(--color-sun)", opacity = 0.09 } = Astro.props;
const paw =
  '<g><ellipse cx="6.4" cy="11" rx="1.9" ry="2.3"/><ellipse cx="9.7" cy="6.6" rx="1.9" ry="2.4"/><ellipse cx="14.3" cy="6.6" rx="1.9" ry="2.4"/><ellipse cx="17.6" cy="11" rx="1.9" ry="2.3"/><path d="M12 12.4c-2.7 0-4.8 1.9-4.8 4.2 0 1.7 1.4 2.7 3.1 2.7.9 0 1.2-.3 1.7-.3s.8.3 1.7.3c1.7 0 3.1-1 3.1-2.7 0-2.3-2.1-4.2-4.8-4.2Z"/></g>';
---
<svg
  class={className}
  width="100%"
  height="100%"
  aria-hidden="true"
  style={`color:${color};opacity:${opacity}`}
  set:html={`
    <defs>
      <pattern id="pawpat" width="88" height="88" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)">
        <g fill="currentColor" transform="translate(8 8) scale(1.15)">${paw}</g>
        <g fill="currentColor" transform="translate(52 50) scale(0.9) rotate(24)">${paw}</g>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#pawpat)"></rect>
  `}
/>
