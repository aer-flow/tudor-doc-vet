---
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  class?: string;
}
const { eyebrow, title, lead, class: className = "" } = Astro.props;
---
<section class:list={["bg-ivory", className]}>
  <div class="container-page py-14 md:py-18">
    <div class="max-w-3xl">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h1 class="text-h1 font-extrabold text-ink"><slot name="title">{title}</slot></h1>
      {lead && <p class="measure mt-5 text-lead text-slate">{lead}</p>}
    </div>
  </div>
</section>
