---
/** Urmă de labe ca separator jucăuș, decorativ. */
interface Props { count?: number; class?: string; color?: string }
const { count = 7, class: className = "", color = "var(--color-indigo)" } = Astro.props;
const paw =
  '<ellipse cx="6.4" cy="11" rx="1.9" ry="2.3"/><ellipse cx="9.7" cy="6.6" rx="1.9" ry="2.4"/><ellipse cx="14.3" cy="6.6" rx="1.9" ry="2.4"/><ellipse cx="17.6" cy="11" rx="1.9" ry="2.3"/><path d="M12 12.4c-2.7 0-4.8 1.9-4.8 4.2 0 1.7 1.4 2.7 3.1 2.7.9 0 1.2-.3 1.7-.3s.8.3 1.7.3c1.7 0 3.1-1 3.1-2.7 0-2.3-2.1-4.2-4.8-4.2Z"/>';
const items = Array.from({ length: count });
---
<div class:list={["flex items-center justify-center gap-5 sm:gap-8", className]} aria-hidden="true">
  {items.map((_, i) => (
    <svg
      class="h-5 w-5 shrink-0 sm:h-6 sm:w-6"
      style={`color:${color};transform:translateY(${i % 2 ? 6 : -6}px) rotate(${i % 2 ? 12 : -12}deg);opacity:${0.16 + i * 0.03}`}
      viewBox="0 0 24 24"
      fill="currentColor"
      set:html={paw}
    />
  ))}
</div>
