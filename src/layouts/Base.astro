---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyCta from "../components/StickyCta.astro";
import { SITE_URL, BRAND, NAP, SOCIAL, SCHEDULE, MAPS_URL, RATING } from "../data/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  /** JSON-LD suplimentar, specific paginii. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, noindex = false, schema } = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL("/og-tudor-doc-vet.jpg", SITE_URL).href;

const openingHours = SCHEDULE.schema.map((s) => ({
  "@type": "OpeningHoursSpecification",
  dayOfWeek: s.days.map((d) => `https://schema.org/${d}`),
  opens: s.opens,
  closes: s.closes,
}));

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "VeterinaryCare",
  "@id": `${SITE_URL}/#cabinet`,
  name: BRAND.legalName,
  alternateName: BRAND.name,
  url: SITE_URL,
  image: ogImage,
  logo: new URL("/logo-tudor-doc-vet.jpg", SITE_URL).href,
  description:
    "Cabinet veterinar în Piatra Neamț pentru câini și pisici: consultații, vaccinare, deparazitare, urgențe și cosmetică veterinară.",
  telephone: NAP.phoneE164,
  email: NAP.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: NAP.street,
    addressLocality: NAP.city,
    addressRegion: NAP.region,
    postalCode: NAP.postalCode,
    addressCountry: NAP.country,
  },
  geo: { "@type": "GeoCoordinates", latitude: NAP.geo.lat, longitude: NAP.geo.lng },
  hasMap: MAPS_URL,
  areaServed: { "@type": "City", name: "Piatra Neamț" },
  openingHoursSpecification: openingHours,
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: 4.5,
    reviewCount: RATING.count,
    bestRating: 5,
  },
  sameAs: [SOCIAL.facebook, SOCIAL.instagram].filter(Boolean),
};

const schemas = [localBusiness, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="ro" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbf8f1" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.remove("no-js");
    </script>
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-70 focus:rounded-full focus:bg-indigo focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-cream"
    >Sari la conținut</a>

    <Header />

    <main id="continut" class="flex-1 pt-18">
      <slot />
    </main>

    <Footer />
    <StickyCta />
    <div class="h-16 lg:hidden" aria-hidden="true"></div>

    <script>
      const automaticText = Array.from(
        document.querySelectorAll<HTMLElement>(
          "main h1, main h2, main h3, main h4, main p, main li, footer p, footer li"
        )
      ).filter((element) => !element.closest("[data-hero-reveal]"));

      const groups = new Map<Element, number>();
      automaticText.forEach((element) => {
        element.classList.add("aos-text");
        const scope = element.closest("section, footer") ?? document.body;
        const position = groups.get(scope) ?? 0;
        element.style.setProperty("--reveal-delay", `${Math.min(position, 5) * 70}ms`);
        groups.set(scope, position + 1);
      });

      const revealGroups = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
      revealGroups.forEach((element) => {
        if (!element.classList.contains("aos-text") && element.querySelector(".aos-text")) {
          element.classList.add("reveal-text-host");
        }
      });

      const visualReveals = revealGroups.filter(
        (element) =>
          !element.classList.contains("aos-text") &&
          !element.classList.contains("reveal-text-host")
      );
      const items = [...automaticText, ...visualReveals];
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduced && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }

      // ── Count-up pe cifre ──────────────────────────────────
      const counters = Array.from(document.querySelectorAll<HTMLElement>(".count"));
      const runCount = (el: HTMLElement) => {
        const target = parseFloat(el.dataset.count || "0");
        const decimals = parseInt(el.dataset.decimals || "0", 10);
        const suffix = el.dataset.suffix || "";
        const dur = 1300;
        const start = performance.now();
        const fmt = (v: number) =>
          v.toLocaleString("ro-RO", { minimumFractionDigits: decimals, maximumFractionDigits: decimals }) + suffix;
        const tick = (now: number) => {
          const t = Math.min((now - start) / dur, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = fmt(target * eased);
          if (t < 1) requestAnimationFrame(tick);
          else el.textContent = fmt(target);
        };
        requestAnimationFrame(tick);
      };
      if (!reduced && counters.length) {
        const cio = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              runCount(entry.target as HTMLElement);
              cio.unobserve(entry.target);
            }
          },
          { threshold: 0.5 }
        );
        counters.forEach((el) => cio.observe(el));
      }

      // ── Parallax subtil pe media ───────────────────────────
      const parallax = Array.from(document.querySelectorAll<HTMLElement>("[data-parallax]"));
      if (!reduced && parallax.length) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight;
          for (const el of parallax) {
            const rect = el.getBoundingClientRect();
            const speed = parseFloat(el.dataset.parallax || "0.12");
            const offset = (rect.top + rect.height / 2 - vh / 2) * -speed;
            el.style.setProperty("--p", `${offset.toFixed(1)}px`);
          }
          ticking = false;
        };
        const onScroll = () => {
          if (!ticking) { requestAnimationFrame(update); ticking = true; }
        };
        update();
        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
